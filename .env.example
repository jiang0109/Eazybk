# =============================================================================
#  环境变量模板
# =============================================================================
#  怎么用：
#     cp .env.example .env      # 复制一份，填上你自己的值
#
#  ⚠️ .env 已经被 .gitignore 忽略，**永远不要**把真实连接串写进这个模板文件。
#     这个文件是可以提交的，它只是"需要配哪些变量"的说明书。
#
#  为什么需要模板？
#     别人 clone 你的仓库后，靠它就知道要配哪些东西，不用去翻代码找 process.env。
#     这也是"密钥不进仓库"这条规矩能落地的关键。
#
#  关于加载方式：
#     Node **不会自动读取 .env**。项目里的 npm 脚本都带了
#     `--env-file-if-exists=.env`，所以直接跑 npm run db:init 之类就能生效。
#     如果绕过 npm 脚本直接 node xxx.ts，需要自己加这个参数。
# =============================================================================

# -----------------------------------------------------------------------------
#  数据库连接串（**必填**）
# -----------------------------------------------------------------------------
# 本项目用 PostgreSQL。本地没有 Postgres 也没关系 —— 用 Neon 的免费档：
#   1. 打开 https://neon.com ，用 GitHub 账号登录
#   2. 创建项目（区域选 Singapore 离国内最近）
#   3. 在 Dashboard 点 Connect，Database 选 neondb，复制 Connection string
#      格式选 "PostgreSQL"（不要选 Prisma / Drizzle 那种带特殊参数的）
#   4. 粘到下面
#
# 连接串长这样：
#   postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
#
# 这条串就是数据库密码，属于最高级别机密：
#   - 只放在 .env（本地）或平台的环境变量面板（线上）
#   - 一旦提交进 git 历史，即使后来删掉也依然能被翻出来，只能去 Neon 重置密码
DATABASE_URL=

# -----------------------------------------------------------------------------
#  测试库连接串（推荐填，但非必填）
# -----------------------------------------------------------------------------
# 测试会大量增删数据（模拟越权攻击、重置演示数据）。如果和开发库共用一个，
# 迟早出现"跑完测试发现演示数据被改乱了"。
#
# 在 Neon 控制台的 Branches → Roles & Databases 标签页点 "Add database"
# 建一个叫 ledger_test 的库（免费），然后把它的连接串填在这里。
# 注意：连接串末尾的库名要跟着变（/ledger_test 而不是 /neondb）。
#
# 留空的话，测试会打在 DATABASE_URL 上 —— 不推荐，但能跑。
TEST_DATABASE_URL=

# -----------------------------------------------------------------------------
#  会话 Cookie 的安全标记
# -----------------------------------------------------------------------------
# 留空 = 自动判断（看反向代理的 x-forwarded-proto 头，Render 线上会正确识别
# 为 https 并自动加上 Secure）。
# 设成 1 = 强制加 Secure（只在 HTTPS 下发送 Cookie）。
# 设成 0 = 强制不加（本地用 http 调试时需要）。
SECURE_COOKIES=

# -----------------------------------------------------------------------------
#  服务端口（生产模式用，默认 3001）
# -----------------------------------------------------------------------------
# 开发模式（npm run dev）由 Vite 决定端口（5173），这个变量不生效。
# 托管平台通常会自动注入 PORT，那时以平台的为准。
PORT=3001

# -----------------------------------------------------------------------------
#  ⚠️ 不要在这里写 NODE_ENV
# -----------------------------------------------------------------------------
# 这是我实际踩过的坑，写下来免得你重蹈：
#
# Vite 在构建时会读取 .env。一旦这里出现 NODE_ENV=development，
# 前端就会被打包成**开发版 React** —— 体积从 211 kB 涨到 396 kB，
# 还带一堆开发期警告，而且**不报错、不警告**。
#
# 排查方式：对比构建产物的体积和内容标记（开发版含 "react.dev"，
# 生产版含 "Minified React error"）。
#
# 结论：NODE_ENV 留给工具链自己管理，应用需要的开关用上面那个 SECURE_COOKIES。
