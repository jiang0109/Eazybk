# =============================================================================
#  环境变量模板
# =============================================================================
#  怎么用：
#     cp .env.example .env      # 复制一份，填上你自己的值
#
#  ⚠️ .env 已经被 .gitignore 忽略，**永远不要**把真实密钥写进这个模板文件。
#     这个文件是可以提交的，它只是"需要配哪些变量"的说明书。
#
#  为什么需要模板？
#     别人 clone 你的仓库后，靠它就知道要配哪些东西，不用去翻代码找 process.env。
#     这也是"密钥不进仓库"这条规矩能落地的关键 —— 有模板，就没人有理由
#     直接把密钥写进代码或提交 .env。
#
#  关于加载方式（重要）：
#     Node 26 **不会自动读取 .env**。本地开发请用：
#         node --env-file-if-exists=.env src/server/index.ts
#     或者在代码里显式调用 process.loadEnvFile()。
#     用 --env-file（不带 -if-exists）时文件不存在会直接报错，
#     所以本地开发推荐带 -if-exists 的那个。
# =============================================================================

# -----------------------------------------------------------------------------
#  服务端口（生产模式用，默认 3001）
# -----------------------------------------------------------------------------
# 开发模式（npm run dev）由 Vite 决定端口（5173），这个变量不生效。
PORT=3001

# -----------------------------------------------------------------------------
#  SQLite 数据库文件路径
# -----------------------------------------------------------------------------
# 默认是 <项目根>/data/ledger.db。留空即用默认值。
# 部署到有持久卷的平台时，把它指向挂载点，例如：
#     DB_PATH=/data/ledger.db
DB_PATH=

# -----------------------------------------------------------------------------
#  运行环境
# -----------------------------------------------------------------------------
# 设为 production 时，会话 Cookie 会带上 Secure 标记（只在 HTTPS 下发送）。
# 本地开发是 http，所以**不要**在本地设成 production，否则浏览器不会保存这个 Cookie。
# 部署到线上（HTTPS）时必须设置，否则 Cookie 缺少 Secure 保护。
NODE_ENV=development

# -----------------------------------------------------------------------------
#  以下为迁移到 PostgreSQL（Neon）后会用到，目前不生效
# -----------------------------------------------------------------------------
# 迁移到 Neon 时，把控制台给的连接串填进来。
# 格式通常长这样（注意 ?sslmode=require，Neon 要求 TLS）：
#     postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require
#
# 这个值就是数据库密码，属于最高级别机密：
#   - 只放在 .env（本地）或平台的环境变量面板（线上）
#   - 一旦提交进 git 历史，即使后来删掉也依然能被翻出来，只能去 Neon 重置密码
# DATABASE_URL=
